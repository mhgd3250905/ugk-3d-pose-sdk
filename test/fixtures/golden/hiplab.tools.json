[
 {
  "type": "function",
  "function": {
   "name": "show_actions",
   "description": "给用户展示 1–6 个动作的演示卡（看动作怎么做，不开练、不带剂量）。",
   "parameters": {
    "type": "object",
    "properties": {
     "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "object",
       "properties": {
        "actionId": {
         "type": "string",
         "enum": [
          "glute-max-A",
          "h-9090-liftoff",
          "h-adductor-rock",
          "h-band-hip-ir",
          "h-band-leg-out",
          "h-butterfly-active",
          "h-couch-stretch",
          "h-hip-gate",
          "h-knee-hug",
          "h-quad-cars",
          "h-reverse-clam",
          "h-squat",
          "h-sumo-pry",
          "h-supine-twist",
          "h-wall-straddle",
          "hip-flexors-A",
          "n-chair-wiper",
          "n-half-split",
          "n-leg-circles",
          "n-pelvis-circle",
          "n-prone-hip-ext",
          "n-prone-ir",
          "n-seated-ir-drop",
          "n-seated-knee-lift",
          "n-seated-squeeze",
          "n-slider-lateral",
          "n-squat-shift",
          "n-straddle-fold",
          "n-thomas-test",
          "n-wide-fold",
          "n-windshield",
          "o-seated-fig4",
          "o-seated-ham",
          "o-stand-crossreach",
          "o-stand-lunge",
          "s-9090",
          "s-butterfly",
          "s-figure4",
          "s-frog",
          "s-kneel-hipflex",
          "s-lizard",
          "s-pigeon",
          "s-seated-fold",
          "t-seated-straddle-lift-1leg",
          "w-clamshell",
          "w-feet-on-chair-bridge"
         ]
        },
        "note": {
         "type": "string",
         "description": "可选，一句说明（不写组数次数）"
        }
       },
       "required": [
        "actionId"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "items"
    ],
    "additionalProperties": false
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "show_plan",
   "description": "给用户一份可直接开练的训练计划（TrainingPlan v1）。修改计划时提交完整新计划。",
   "parameters": {
    "type": "object",
    "properties": {
     "schemaVersion": {
      "type": "integer",
      "enum": [
       1
      ]
     },
     "title": {
      "type": "string",
      "description": "≤12 字"
     },
     "summary": {
      "type": "string"
     },
     "goal": {
      "type": "string",
      "enum": [
       "relax",
       "mobility",
       "strength",
       "core",
       "fullbody",
       "warmup",
       "cooldown"
      ]
     },
     "scene": {
      "type": "string",
      "enum": [
       "home",
       "office"
      ]
     },
     "equipment": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     },
     "targetMinutes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 40
     },
     "avoid": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "膝",
        "腰",
        "肩",
        "手腕",
        "颈",
        "髋",
        "大腿内侧"
       ]
      }
     },
     "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "type": {
         "type": "string",
         "enum": [
          "warmup",
          "main",
          "circuit",
          "cooldown"
         ]
        },
        "rounds": {
         "type": "integer",
         "minimum": 1,
         "maximum": 6
        },
        "restBetweenRoundsSeconds": {
         "type": "integer",
         "minimum": 0,
         "maximum": 300
        },
        "items": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "properties": {
           "exerciseId": {
            "type": "string",
            "enum": [
             "glute-max-A",
             "h-9090-liftoff",
             "h-adductor-rock",
             "h-band-hip-ir",
             "h-band-leg-out",
             "h-butterfly-active",
             "h-couch-stretch",
             "h-hip-gate",
             "h-knee-hug",
             "h-quad-cars",
             "h-reverse-clam",
             "h-squat",
             "h-sumo-pry",
             "h-supine-twist",
             "h-wall-straddle",
             "hip-flexors-A",
             "n-chair-wiper",
             "n-half-split",
             "n-leg-circles",
             "n-pelvis-circle",
             "n-prone-hip-ext",
             "n-prone-ir",
             "n-seated-ir-drop",
             "n-seated-knee-lift",
             "n-seated-squeeze",
             "n-slider-lateral",
             "n-squat-shift",
             "n-straddle-fold",
             "n-thomas-test",
             "n-wide-fold",
             "n-windshield",
             "o-seated-fig4",
             "o-seated-ham",
             "o-stand-crossreach",
             "o-stand-lunge",
             "s-9090",
             "s-butterfly",
             "s-figure4",
             "s-frog",
             "s-kneel-hipflex",
             "s-lizard",
             "s-pigeon",
             "s-seated-fold",
             "t-seated-straddle-lift-1leg",
             "w-clamshell",
             "w-feet-on-chair-bridge"
            ]
           },
           "mode": {
            "type": "string",
            "enum": [
             "reps",
             "time"
            ]
           },
           "sets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
           },
           "reps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
           },
           "workSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120
           },
           "perSide": {
            "type": "boolean"
           },
           "restSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 180
           },
           "note": {
            "type": "string"
           }
          },
          "required": [
           "exerciseId",
           "mode",
           "sets",
           "perSide",
           "restSeconds"
          ]
         }
        }
       },
       "required": [
        "type",
        "items"
       ]
      }
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "safetyNotes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "schemaVersion",
     "title",
     "summary",
     "goal",
     "scene",
     "level",
     "targetMinutes",
     "blocks"
    ]
   }
  }
 }
]