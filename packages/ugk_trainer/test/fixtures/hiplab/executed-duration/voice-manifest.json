   "zh": "后侧臀部收紧，髋慢慢往前推"
  },
  "point.s-lizard": {
   "en": "Front foot outside your hand, sink the hips",
   "zh": "前脚放在手外侧，髋往下沉"
  },
  "point.s-pigeon": {
