{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhgd3250905/ugk-3d-pose-sdk/schema/coach-reply.schema.json",
  "title": "助理回复信封 + TrainingPlan v1",
  "description": "模型每轮只输出一个这样的对象。结构由 EnvelopeParser / PlanCodec 检查，业务规则（动作在目录与 profile 内、剂量、器械、场所、保护部位、块顺序、perSide）由 PlanValidator 检查。TrainingPlan v1 与 SmartFit docs/plan-schema.md 同一 JSON。",
  "type": "object",
  "required": ["kind", "text"],
  "properties": {
    "kind": {"enum": ["reply", "ask", "plan"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 400},
    "options": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
    "plan": {"$ref": "#/$defs/plan"}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "plan"}}}, "then": {"required": ["plan"]}}],
  "$defs": {
    "segmentRhythm": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["rep_updown", "rep_cycle", "rep_alternate", "rep_hold", "rep_breath", "hold"]},
        "leadSeconds": {"type": "number", "minimum": 0},
        "holdSeconds": {"type": "integer", "minimum": 1},
        "reps": {"type": "integer", "minimum": 1},
        "phases": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "required": ["id", "seconds"],
            "properties": {
              "id": {"type": "string", "pattern": "\\S"},
              "seconds": {"type": "number", "exclusiveMinimum": 0},
              "cueAt": {"type": "number", "minimum": 0},
              "cue": {"oneOf": [{"type": "string"}, {"type": "null"}, {"type": "array", "items": {"type": "string"}}]}
            }
          }
        }
      },
      "description": "App/目录作者提供的内联节奏；self_paced 仅允许目录标记。阶段 id 唯一和 cueAt 不超过该阶段秒数由 PlanCodec/PlanValidator 检查。"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "exerciseId", "mode"],
      "properties": {
        "id": {"type": "string", "pattern": "\\S", "description": "本计划项内唯一，由 PlanCodec/PlanValidator 检查"},
        "exerciseId": {"type": "string", "pattern": "\\S"},
        "mode": {"enum": ["reps", "time"]},
        "reps": {"type": "integer", "minimum": 1},
        "workSeconds": {"type": "integer", "minimum": 1},
        "holdSeconds": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "pattern": "\\S"},
        "rhythm": {"$ref": "#/$defs/segmentRhythm"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "reps"}}}, "then": {"required": ["reps"], "not": {"required": ["workSeconds"]}}},
        {"if": {"properties": {"mode": {"const": "time"}}}, "then": {"required": ["workSeconds"], "not": {"required": ["reps"]}}}
      ]
    },
    "item": {
      "type": "object",
      "required": ["exerciseId", "mode", "sets", "perSide", "restSeconds"],
      "properties": {
        "exerciseId": {"type": "string"},
        "mode": {"enum": ["reps", "time"]},
        "sets": {"type": "integer", "minimum": 1, "maximum": 6},
        "reps": {"type": "integer", "minimum": 1, "maximum": 30},
        "workSeconds": {"type": "integer", "minimum": 10, "maximum": 120},
        "perSide": {"type": "boolean"},
        "restSeconds": {"type": "integer", "minimum": 0, "maximum": 180},
        "note": {"type": "string"},
        "replacedFrom": {"type": "string"},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}, "description": "由 App/目录作者提供；非空时按顺序替代父工作剂量，继承父组数、侧别和休息；本次不扩展 Agent 工具生成约定。"}
      },
      "allOf": [
        {"if": {"not": {"required": ["segments"], "properties": {"segments": {"minItems": 1}}}}, "then": {"allOf": [
          {"if": {"properties": {"mode": {"const": "reps"}}}, "then": {"required": ["reps"]}},
          {"if": {"properties": {"mode": {"const": "time"}}}, "then": {"required": ["workSeconds"]}}
        ]}}
      ]
    },
    "block": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"enum": ["warmup", "main", "circuit", "cooldown"]},
        "rounds": {"type": "integer", "minimum": 1, "maximum": 6},
        "restBetweenRoundsSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "plan": {
      "type": "object",
      "required": ["schemaVersion", "title", "summary", "goal", "scene", "level", "targetMinutes", "blocks"],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {"type": "string", "description": "模型可不写，SDK 分配"},
        "source": {"enum": ["template", "ai"]},
        "templateId": {"type": "string"},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "goal": {"enum": ["relax", "mobility", "strength", "core", "fullbody", "warmup", "cooldown"]},
        "scene": {"enum": ["home", "office", "gym"]},
        "equipment": {"type": "array", "items": {"type": "string"}},
        "level": {"enum": [1, 2, 3]},
        "targetMinutes": {"type": "integer"},
        "avoid": {"type": "array", "items": {"type": "string"}},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "safetyNotes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
