{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhgd3250905/ugk-3d-pose-sdk/schema/coach-reply.schema.json",
  "title": "助理回复信封 + TrainingPlan v1",
  "description": "模型每轮只输出一个这样的对象。结构由 EnvelopeParser / PlanCodec 检查，业务规则（动作在目录与 profile 内、剂量、器械、场所、保护部位、块顺序、perSide）由 PlanValidator 检查。TrainingPlan v1 与 SmartFit docs/plan-schema.md 同一 JSON。",
  "type": "object",
  "required": ["kind", "text"],
  "properties": {
    "kind": {"enum": ["reply", "ask", "plan"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 400},
    "options": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
    "plan": {"$ref": "#/$defs/plan"}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "plan"}}}, "then": {"required": ["plan"]}}],
  "$defs": {
    "item": {
      "type": "object",
      "required": ["exerciseId", "mode", "sets", "perSide", "restSeconds"],
      "properties": {
        "exerciseId": {"type": "string"},
        "mode": {"enum": ["reps", "time"]},
        "sets": {"type": "integer", "minimum": 1, "maximum": 6},
        "reps": {"type": "integer", "minimum": 1, "maximum": 30},
        "workSeconds": {"type": "integer", "minimum": 10, "maximum": 120},
        "perSide": {"type": "boolean"},
        "restSeconds": {"type": "integer", "minimum": 0, "maximum": 180},
        "note": {"type": "string"},
        "replacedFrom": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "reps"}}}, "then": {"required": ["reps"]}},
        {"if": {"properties": {"mode": {"const": "time"}}}, "then": {"required": ["workSeconds"]}}
      ]
    },
    "block": {
      "type": "object",
      "required": ["type", "items"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"enum": ["warmup", "main", "circuit", "cooldown"]},
        "rounds": {"type": "integer", "minimum": 1, "maximum": 6},
        "restBetweenRoundsSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "plan": {
      "type": "object",
      "required": ["schemaVersion", "title", "summary", "goal", "scene", "level", "targetMinutes", "blocks"],
      "properties": {
        "schemaVersion": {"const": 1},
        "id": {"type": "string", "description": "模型可不写，SDK 分配"},
        "source": {"enum": ["template", "ai"]},
        "templateId": {"type": "string"},
        "title": {"type": "string"},
        "summary": {"type": "string"},
        "goal": {"enum": ["relax", "mobility", "strength", "core", "fullbody", "warmup", "cooldown"]},
        "scene": {"enum": ["home", "office", "gym"]},
        "equipment": {"type": "array", "items": {"type": "string"}},
        "level": {"enum": [1, 2, 3]},
        "targetMinutes": {"type": "integer"},
        "avoid": {"type": "array", "items": {"type": "string"}},
        "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "safetyNotes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
