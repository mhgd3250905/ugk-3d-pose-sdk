[
 {
  "type": "function",
  "function": {
   "name": "show_actions",
   "description": "给用户展示 1–6 个动作的演示卡（看动作怎么做，不开练、不带剂量）。",
   "parameters": {
    "type": "object",
    "properties": {
     "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "object",
       "properties": {
        "actionId": {
         "type": "string",
         "enum": [
          "abs-A",
          "abs-B",
          "abs-C",
          "adductors-A",
          "adductors-B",
          "adductors-C",
          "chest-A",
          "chest-B",
          "chest-C",
          "deltoids-A",
          "deltoids-B",
          "deltoids-C",
          "erectors-A",
          "erectors-B",
          "erectors-C",
          "forearms-A",
          "forearms-B",
          "forearms-C",
          "glute-max-A",
          "glute-max-B",
          "glute-max-C",
          "hamstrings-A",
          "hamstrings-B",
          "hamstrings-C",
          "hip-abductors-A",
          "hip-abductors-B",
          "hip-abductors-C",
          "hip-flexors-A",
          "hip-flexors-B",
          "hip-flexors-C",
          "lats-A",
          "lats-B",
          "lats-C",
          "obliques-A",
          "obliques-B",
          "obliques-C",
          "quadriceps-A",
          "quadriceps-B",
          "quadriceps-C",
          "rotator-cuff-A",
          "rotator-cuff-B",
          "rotator-cuff-C",
          "scapular-A",
          "scapular-B",
          "scapular-C",
          "serratus-A",
          "serratus-B",
          "serratus-C",
          "triceps-A",
          "triceps-B",
          "triceps-C"
         ]
        },
        "note": {
         "type": "string",
         "description": "可选，一句说明（不写组数次数）"
        }
       },
       "required": [
        "actionId"
       ],
       "additionalProperties": false
      }
     }
    },
    "required": [
     "items"
    ],
    "additionalProperties": false
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "show_plan",
   "description": "给用户一份可直接开练的训练计划（TrainingPlan v1）。修改计划时提交完整新计划。",
   "parameters": {
    "type": "object",
    "properties": {
     "schemaVersion": {
      "type": "integer",
      "enum": [
       1
      ]
     },
     "title": {
      "type": "string",
      "description": "≤12 字"
     },
     "summary": {
      "type": "string"
     },
     "goal": {
      "type": "string",
      "enum": [
       "relax",
       "mobility",
       "strength",
       "core",
       "fullbody",
       "warmup",
       "cooldown"
      ]
     },
     "scene": {
      "type": "string",
      "enum": [
       "home",
       "gym"
      ]
     },
     "equipment": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
     },
     "targetMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
     },
     "avoid": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "膝",
        "腰",
        "肩",
        "手腕",
        "颈",
        "髋",
        "大腿内侧"
       ]
      }
     },
     "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "type": {
         "type": "string",
         "enum": [
          "warmup",
          "main",
          "circuit",
          "cooldown"
         ]
        },
        "rounds": {
         "type": "integer",
         "minimum": 1,
         "maximum": 6
        },
        "restBetweenRoundsSeconds": {
         "type": "integer",
         "minimum": 0,
         "maximum": 300
        },
        "items": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "object",
          "properties": {
           "exerciseId": {
            "type": "string",
            "enum": [
             "abs-A",
             "abs-B",
             "abs-C",
             "adductors-A",
             "adductors-B",
             "adductors-C",
             "chest-A",
             "chest-B",
             "chest-C",
             "deltoids-A",
             "deltoids-B",
             "deltoids-C",
             "erectors-A",
             "erectors-B",
             "erectors-C",
             "forearms-A",
             "forearms-B",
             "forearms-C",
             "glute-max-A",
             "glute-max-B",
             "glute-max-C",
             "hamstrings-A",
             "hamstrings-B",
             "hamstrings-C",
             "hip-abductors-A",
             "hip-abductors-B",
             "hip-abductors-C",
             "hip-flexors-A",
             "hip-flexors-B",
             "hip-flexors-C",
             "lats-A",
             "lats-B",
             "lats-C",
             "obliques-A",
             "obliques-B",
             "obliques-C",
             "quadriceps-A",
             "quadriceps-B",
             "quadriceps-C",
             "rotator-cuff-A",
             "rotator-cuff-B",
             "rotator-cuff-C",
             "scapular-A",
             "scapular-B",
             "scapular-C",
             "serratus-A",
             "serratus-B",
             "serratus-C",
             "triceps-A",
             "triceps-B",
             "triceps-C"
            ]
           },
           "mode": {
            "type": "string",
            "enum": [
             "reps",
             "time"
            ]
           },
           "sets": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
           },
           "reps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
           },
           "workSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 120
           },
           "perSide": {
            "type": "boolean"
           },
           "restSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 180
           },
           "note": {
            "type": "string"
           }
          },
          "required": [
           "exerciseId",
           "mode",
           "sets",
           "perSide",
           "restSeconds"
          ]
         }
        }
       },
       "required": [
        "type",
        "items"
       ]
      }
     },
     "notes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "safetyNotes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "schemaVersion",
     "title",
     "summary",
     "goal",
     "scene",
     "level",
     "targetMinutes",
     "blocks"
    ]
   }
  }
 }
]